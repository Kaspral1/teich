{#-
Experimental Gemma 4 chat template, Minja-compatible edition.

Goals:
- keep Gemma/Gemma-native visible tokens/tags;
- merge leading system/developer messages;
- keep tool definitions in the system turn;
- render OpenAI-style assistant tool_calls followed by consecutive role:tool
  responses using Google/Gemma-native tool-call/tool-response sequencing;
- resolve tool_call_id back to the function name;
- preserve historical reasoning when preserve_thinking is enabled;
- keep enable_thinking and preserve_thinking defaulted to true intentionally;
- strip <|channel>...</channel>, <think>...</think>, and
  <thinking>...</thinking> blocks from assistant visible content.

Minja compatibility notes:
- avoids reverse slicing, map/list filters, replace filter, JSON helper formatting,
  and Python-style .get(default) patterns;
- uses only common chat-template features: if/for/set, namespace, macros,
  range, dictsort, trim, and simple tests.
-#}

{%- macro type_name(t) -%}
    {%- if t == 'string' or t == 'STRING' -%}STRING
    {%- elif t == 'object' or t == 'OBJECT' -%}OBJECT
    {%- elif t == 'array' or t == 'ARRAY' -%}ARRAY
    {%- elif t == 'number' or t == 'NUMBER' -%}NUMBER
    {%- elif t == 'integer' or t == 'INTEGER' -%}INTEGER
    {%- elif t == 'boolean' or t == 'BOOLEAN' -%}BOOLEAN
    {%- elif t == 'null' or t == 'NULL' -%}NULL
    {%- else -%}{{- t -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro format_argument(argument, escape_keys=true) -%}
    {%- if argument is string -%}
        {{- '<|"|>' + argument + '<|"|>' -}}
    {%- elif argument is boolean -%}
        {{- 'true' if argument else 'false' -}}
    {%- elif argument is mapping -%}
        {{- '{' -}}
        {%- set ns = namespace(found_first=false) -%}
        {%- for key, value in argument | dictsort -%}
            {%- if ns.found_first %},{% endif -%}
            {%- set ns.found_first = true -%}
            {%- if escape_keys -%}
                {{- '<|"|>' + key + '<|"|>' -}}
            {%- else -%}
                {{- key -}}
            {%- endif -%}
            {{- ':' -}}{{- format_argument(value, escape_keys) -}}
        {%- endfor -%}
        {{- '}' -}}
    {%- elif argument is sequence and argument is not string -%}
        {{- '[' -}}
        {%- for item in argument -%}
            {{- format_argument(item, escape_keys) -}}
            {%- if not loop.last %},{% endif -%}
        {%- endfor -%}
        {{- ']' -}}
    {%- elif argument is none -%}
        {{- 'null' -}}
    {%- else -%}
        {{- argument -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro format_parameters(properties, required, filter_keys=false) -%}
    {%- set standard_keys = ['description', 'type', 'properties', 'required', 'nullable'] -%}
    {%- set ns = namespace(found_first=false) -%}
    {%- for key, value in properties | dictsort -%}
        {%- set add_comma = false -%}
        {%- if not filter_keys or key not in standard_keys -%}
            {%- if ns.found_first %},{% endif -%}
            {%- set ns.found_first = true -%}
            {{- key -}}{{- ':{' -}}
            {%- if value['description'] -%}
                {{- 'description:<|"|>' -}}{{- value['description'] -}}{{- '<|"|>' -}}
                {%- set add_comma = true -%}
            {%- endif -%}

            {%- if value['type'] and type_name(value['type']) == 'STRING' -%}
                {%- if value['enum'] -%}
                    {%- if add_comma %},{% endif -%}
                    {{- 'enum:' -}}{{- format_argument(value['enum']) -}}
                    {%- set add_comma = true -%}
                {%- endif -%}
            {%- elif value['type'] and type_name(value['type']) == 'ARRAY' -%}
                {%- if value['items'] is mapping and value['items'] -%}
                    {%- if add_comma %},{% endif -%}
                    {{- 'items:{' -}}
                    {%- set ns_items = namespace(found_first=false) -%}
                    {%- for item_key, item_value in value['items'] | dictsort -%}
                        {%- if item_value is not none -%}
                            {%- if ns_items.found_first %},{% endif -%}
                            {%- set ns_items.found_first = true -%}
                            {%- if item_key == 'properties' -%}
                                {{- 'properties:{' -}}
                                {%- if item_value is mapping -%}
                                    {{- format_parameters(item_value, value['items']['required']) -}}
                                {%- endif -%}
                                {{- '}' -}}
                            {%- elif item_key == 'required' -%}
                                {{- 'required:[' -}}
                                {%- for req_item in item_value -%}
                                    {{- '<|"|>' -}}{{- req_item -}}{{- '<|"|>' -}}
                                    {%- if not loop.last %},{% endif -%}
                                {%- endfor -%}
                                {{- ']' -}}
                            {%- elif item_key == 'type' -%}
                                {%- if item_value is string -%}
                                    {{- 'type:<|"|>' -}}{{- type_name(item_value) -}}{{- '<|"|>' -}}
                                {%- else -%}
                                    {{- 'type:' -}}{{- format_argument(item_value) -}}
                                {%- endif -%}
                            {%- else -%}
                                {{- item_key -}}{{- ':' -}}{{- format_argument(item_value) -}}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                    {{- '}' -}}
                    {%- set add_comma = true -%}
                {%- endif -%}
            {%- endif -%}

            {%- if value['nullable'] -%}
                {%- if add_comma %},{% endif -%}
                {{- 'nullable:true' -}}
                {%- set add_comma = true -%}
            {%- endif -%}

            {%- if value['type'] and type_name(value['type']) == 'OBJECT' -%}
                {%- if value['properties'] is mapping -%}
                    {%- if add_comma %},{% endif -%}
                    {{- 'properties:{' -}}
                    {{- format_parameters(value['properties'], value['required']) -}}
                    {{- '}' -}}
                    {%- set add_comma = true -%}
                {%- elif value is mapping -%}
                    {%- if add_comma %},{% endif -%}
                    {{- 'properties:{' -}}
                    {{- format_parameters(value, value['required'], true) -}}
                    {{- '}' -}}
                    {%- set add_comma = true -%}
                {%- endif -%}
                {%- if value['required'] -%}
                    {%- if add_comma %},{% endif -%}
                    {{- 'required:[' -}}
                    {%- for item in value['required'] -%}
                        {{- '<|"|>' -}}{{- item -}}{{- '<|"|>' -}}
                        {%- if not loop.last %},{% endif -%}
                    {%- endfor -%}
                    {{- ']' -}}
                    {%- set add_comma = true -%}
                {%- endif -%}
            {%- endif -%}

            {%- if add_comma %},{% endif -%}
            {{- 'type:<|"|>' -}}
            {%- if value['type'] -%}{{- type_name(value['type']) -}}{%- else -%}STRING{%- endif -%}
            {{- '<|"|>}' -}}
        {%- endif -%}
    {%- endfor -%}
{%- endmacro -%}

{%- macro format_function_declaration(tool_data) -%}
    {%- if tool_data['function'] -%}
        {%- set function = tool_data['function'] -%}
    {%- else -%}
        {%- set function = tool_data -%}
    {%- endif -%}
    {{- 'declaration:' -}}{{- function['name'] -}}{{- '{description:<|"|>' -}}
    {%- if function['description'] -%}{{- function['description'] -}}{%- endif -%}
    {{- '<|"|>' -}}
    {%- set params = function['parameters'] -%}
    {%- if params -%}
        {{- ',parameters:{' -}}
        {%- if params['properties'] -%}
            {{- 'properties:{' -}}{{- format_parameters(params['properties'], params['required']) -}}{{- '},' -}}
        {%- endif -%}
        {%- if params['required'] -%}
            {{- 'required:[' -}}
            {%- for item in params['required'] -%}
                {{- '<|"|>' -}}{{- item -}}{{- '<|"|>' -}}
                {%- if not loop.last %},{% endif -%}
            {%- endfor -%}
            {{- '],' -}}
        {%- endif -%}
        {%- if params['type'] -%}
            {{- 'type:<|"|>' -}}{{- type_name(params['type']) -}}{{- '<|"|>}' -}}
        {%- endif -%}
    {%- endif -%}
    {%- if function['response'] -%}
        {%- set response_declaration = function['response'] -%}
        {{- ',response:{' -}}
        {%- if response_declaration['description'] -%}
            {{- 'description:<|"|>' -}}{{- response_declaration['description'] -}}{{- '<|"|>,' -}}
        {%- endif -%}
        {%- if response_declaration['type'] -%}
            {{- 'type:<|"|>' -}}{{- type_name(response_declaration['type']) -}}{{- '<|"|>}' -}}
        {%- endif -%}
    {%- endif -%}
    {{- '}' -}}
{%- endmacro -%}

{%- macro strip_thinking(text) -%}
    {%- set ns = namespace(result='') -%}
    {%- for part in text.split('<channel|>') -%}
        {%- if '<|channel>' in part -%}
            {%- set ns.result = ns.result + part.split('<|channel>')[0] -%}
        {%- else -%}
            {%- set ns.result = ns.result + part -%}
        {%- endif -%}
    {%- endfor -%}

    {%- set ns2 = namespace(result='') -%}
    {%- for part in ns.result.split('</think>') -%}
        {%- if '<think>' in part -%}
            {%- set ns2.result = ns2.result + part.split('<think>')[0] -%}
        {%- else -%}
            {%- set ns2.result = ns2.result + part -%}
        {%- endif -%}
    {%- endfor -%}

    {%- set ns3 = namespace(result='') -%}
    {%- for part in ns2.result.split('</thinking>') -%}
        {%- if '<thinking>' in part -%}
            {%- set ns3.result = ns3.result + part.split('<thinking>')[0] -%}
        {%- else -%}
            {%- set ns3.result = ns3.result + part -%}
        {%- endif -%}
    {%- endfor -%}

    {{- ns3.result | trim -}}
{%- endmacro -%}

{%- macro render_content(content, is_system_content=false, strip_model_thinking=false) -%}
    {%- if content is string -%}
        {%- if strip_model_thinking -%}
            {{- strip_thinking(content) -}}
        {%- else -%}
            {{- content -}}
        {%- endif -%}
    {%- elif content is sequence and content is not string -%}
        {%- for item in content -%}
            {%- if item['type'] == 'text' or item['text'] -%}
                {%- if strip_model_thinking -%}
                    {{- strip_thinking(item['text']) -}}
                {%- else -%}
                    {{- item['text'] -}}
                {%- endif -%}
            {%- elif item['type'] == 'image' or item['image'] or item['image_url'] -%}
                {%- if is_system_content -%}
                    {{- raise_exception('System message cannot contain images.') -}}
                {%- endif -%}
                {{- '<|image|>' -}}
            {%- elif item['type'] == 'audio' or item['audio'] -%}
                {%- if is_system_content -%}
                    {{- raise_exception('System message cannot contain audio.') -}}
                {%- endif -%}
                {{- '<|audio|>' -}}
            {%- elif item['type'] == 'video' or item['video'] -%}
                {%- if is_system_content -%}
                    {{- raise_exception('System message cannot contain videos.') -}}
                {%- endif -%}
                {{- '<|video|>' -}}
            {%- else -%}
                {{- raise_exception('Unexpected item type in content.') -}}
            {%- endif -%}
        {%- endfor -%}
    {%- else -%}
        {{- content -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro format_tool_response_block(tool_name, response) -%}
    {{- '<|tool_response>' -}}
    {%- if response is mapping -%}
        {{- 'response:' -}}{{- tool_name -}}{{- '{' -}}
        {%- for key, value in response | dictsort -%}
            {{- key -}}{{- ':' -}}{{- format_argument(value, false) -}}
            {%- if not loop.last %},{% endif -%}
        {%- endfor -%}
        {{- '}' -}}
    {%- else -%}
        {{- 'response:' -}}{{- tool_name -}}{{- '{value:' -}}{{- format_argument(response, false) -}}{{- '}' -}}
    {%- endif -%}
    {{- '<tool_response|>' -}}
{%- endmacro -%}

{%- if enable_thinking is not defined -%}
    {%- set enable_thinking = true -%}
{%- endif -%}
{%- if preserve_thinking is not defined -%}
    {%- set preserve_thinking = true -%}
{%- endif -%}

{%- if not messages -%}
    {{- raise_exception('No messages provided.') -}}
{%- endif -%}

{{- bos_token -}}

{#- Merge leading system/developer messages into one native system turn. -#}
{%- set header = namespace(text='', count=0) -%}
{%- for message in messages -%}
    {%- if loop.index0 == header.count and (message['role'] == 'system' or message['role'] == 'developer') -%}
        {%- set content = render_content(message['content'], true) | trim -%}
        {%- if content -%}
            {%- if header.text -%}
                {%- set header.text = header.text + '\n' + content -%}
            {%- else -%}
                {%- set header.text = content -%}
            {%- endif -%}
        {%- endif -%}
        {%- set header.count = header.count + 1 -%}
    {%- endif -%}
{%- endfor -%}

{%- if enable_thinking or header.text or tools -%}
    {{- '<|turn>system\n' -}}
    {%- if enable_thinking -%}
        {{- '<|think|>\n' -}}
    {%- endif -%}
    {%- if tools -%}
        {%- for tool in tools -%}
            {{- '<|tool>' -}}
            {{- format_function_declaration(tool) | trim -}}
            {{- '<tool|>' -}}
        {%- endfor -%}
        {%- if header.text -%}{{- '\n' -}}{%- endif -%}
    {%- endif -%}
    {{- header.text -}}
    {{- '<turn|>\n' -}}
{%- endif -%}

{#- Find last user message index without reverse slicing. -#}
{%- set ns_scan = namespace(last_query_index=messages | length - 1, found_last_query=false) -%}
{%- for i in range(messages | length) -%}
    {%- if messages[i]['role'] == 'user' -%}
        {%- set ns_scan.last_query_index = i -%}
        {%- set ns_scan.found_last_query = true -%}
    {%- endif -%}
{%- endfor -%}

{%- set state = namespace(prev_message_type='') -%}

{%- for message in messages -%}
    {%- set i = loop.index0 -%}
    {%- set role = message['role'] -%}
    {%- if i >= header.count and role != 'system' and role != 'developer' and role != 'tool' -%}
        {%- if role == 'assistant' -%}
            {%- set output_role = 'model' -%}
        {%- else -%}
            {%- set output_role = role -%}
        {%- endif -%}

        {%- set continue_same_model_turn = output_role == 'model' and state.prev_message_type == 'tool_response' -%}
        {%- if not continue_same_model_turn -%}
            {{- '<|turn>' -}}{{- output_role -}}{{- '\n' -}}
        {%- endif -%}
        {%- set state.prev_message_type = '' -%}

        {%- if output_role == 'model' -%}
            {%- set reasoning_content = '' -%}
            {%- if message['reasoning_content'] -%}
                {%- set reasoning_content = message['reasoning_content'] -%}
            {%- elif message['reasoning'] -%}
                {%- set reasoning_content = message['reasoning'] -%}
            {%- elif message['thinking'] -%}
                {%- set reasoning_content = message['thinking'] -%}
            {%- endif -%}

            {%- set content = render_content(message['content'], false, true) | trim -%}

            {%- if reasoning_content | trim and (preserve_thinking or i > ns_scan.last_query_index) -%}
                {{- '<|channel>thought\n' -}}{{- reasoning_content | trim -}}{{- '\n<channel|>' -}}
            {%- endif -%}

            {%- if message['tool_calls'] and message['tool_calls'] is sequence -%}
                {%- if content -%}{{- content -}}{%- endif -%}

                {%- for tool_call in message['tool_calls'] -%}
                    {%- if tool_call['function'] -%}
                        {%- set function = tool_call['function'] -%}
                    {%- else -%}
                        {%- set function = tool_call -%}
                    {%- endif -%}
                    {{- '<|tool_call>call:' -}}{{- function['name'] -}}{{- '{' -}}
                    {%- if function['arguments'] is mapping -%}
                        {%- set ns_args = namespace(found_first=false) -%}
                        {%- for key, value in function['arguments'] | dictsort -%}
                            {%- if ns_args.found_first %},{% endif -%}
                            {%- set ns_args.found_first = true -%}
                            {{- key -}}{{- ':' -}}{{- format_argument(value, false) -}}
                        {%- endfor -%}
                    {%- elif function['arguments'] is string -%}
                        {{- function['arguments'] -}}
                    {%- endif -%}
                    {{- '}<tool_call|>' -}}
                {%- endfor -%}

                {%- set ns_tool = namespace(found_response=false, stopped=false) -%}
                {%- for k in range(i + 1, messages | length) -%}
                    {%- if ns_tool.stopped -%}
                    {%- elif messages[k]['role'] != 'tool' -%}
                        {%- set ns_tool.stopped = true -%}
                    {%- else -%}
                        {%- set follow = messages[k] -%}
                        {%- set ns_tname = namespace(name='unknown') -%}
                        {%- if follow['name'] -%}
                            {%- set ns_tname.name = follow['name'] -%}
                        {%- endif -%}
                        {%- for tc in message['tool_calls'] -%}
                            {%- if tc['id'] == follow['tool_call_id'] -%}
                                {%- if tc['function'] -%}
                                    {%- set tc_func = tc['function'] -%}
                                {%- else -%}
                                    {%- set tc_func = tc -%}
                                {%- endif -%}
                                {%- if tc_func['name'] -%}
                                    {%- set ns_tname.name = tc_func['name'] -%}
                                {%- endif -%}
                            {%- endif -%}
                        {%- endfor -%}

                        {%- set tool_body = follow['content'] -%}
                        {%- if tool_body is mapping -%}
                            {{- format_tool_response_block(ns_tname.name, tool_body) -}}
                        {%- elif tool_body is sequence and tool_body is not string -%}
                            {%- set ns_txt = namespace(s='') -%}
                            {%- for part in tool_body -%}
                                {%- if part['type'] == 'text' or part['text'] -%}
                                    {%- set ns_txt.s = ns_txt.s + part['text'] -%}
                                {%- endif -%}
                            {%- endfor -%}
                            {{- format_tool_response_block(ns_tname.name, ns_txt.s) -}}
                        {%- else -%}
                            {{- format_tool_response_block(ns_tname.name, tool_body) -}}
                        {%- endif -%}
                        {%- set ns_tool.found_response = true -%}
                    {%- endif -%}
                {%- endfor -%}

                {%- if ns_tool.found_response and not content -%}
                    {%- set state.prev_message_type = 'tool_response' -%}
                {%- elif ns_tool.found_response -%}
                    {{- '<turn|>\n' -}}
                    {%- set state.prev_message_type = 'tool_response' -%}
                {%- else -%}
                    {{- '<|tool_response>' -}}
                    {%- set state.prev_message_type = 'tool_call' -%}
                {%- endif -%}
            {%- else -%}
                {{- content -}}
                {{- '<turn|>\n' -}}
            {%- endif -%}
        {%- else -%}
            {{- render_content(message['content']) | trim -}}
            {{- '<turn|>\n' -}}
        {%- endif -%}
    {%- endif -%}
{%- endfor -%}

{%- if add_generation_prompt -%}
    {%- if state.prev_message_type != 'tool_response' and state.prev_message_type != 'tool_call' -%}
        {{- '<|turn>model\n' -}}
        {%- if not enable_thinking -%}
            {{- '<|channel>thought\n<channel|>' -}}
        {%- endif -%}
    {%- endif -%}
{%- endif -%}
